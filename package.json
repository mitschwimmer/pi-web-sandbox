{
  "name": "@mitschwimmer/pi-web-sandbox",
  "version": "0.1.0",
  "description": "Headless Pi service and source fork of kkkiio/pi-web-ui",
  "keywords": [
    "pi",
    "pi-package",
    "coding-agent",
    "web-ui"
  ],
  "author": "kkkiio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitschwimmer/pi-web-sandbox.git"
  },
  "pi": {
    "extensions": [
      "./extensions/mirror-server.ts"
    ]
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "preview:web": "vite preview --host 127.0.0.1",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci:biome": "biome ci .",
    "start": "node service/cli.mjs",
    "test": "node --test test/*.test.mjs",
    "bundle": "sh scripts/bundle.sh"
  },
  "dependencies": {
    "ws": "^8.16.0",
    "@earendil-works/pi-coding-agent": "1.0.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.193",
    "@biomejs/biome": "2.4.15",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "^4.1.0",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "use-stick-to-bottom": "^1.1.4",
    "vite": "^8.0.14"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "files": [
    "extensions/mirror-server.ts",
    "service/",
    "dist/",
    "LICENSE",
    "README.md",
    "UPSTREAM.md"
  ],
  "private": true,
  "bin": {
    "pi-web-sandbox": "service/cli.mjs"
  }
}
